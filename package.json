{
  "name": "pamize-synapse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/compliance-preview-build-check.mjs && npm run test:compliance:provisions && npm run test:compliance:articles && npm run test:compliance:eurlex && npm run test:compliance:report && npm run test:compliance:versions && npm run test:compliance:gdpr-reference && npm run test:compliance:agent-obligations && npm run test:compliance:impact && npm run test:compliance:assessment-review && npm run test:compliance:authorization && npm run test:compliance:entra-boundary && npm run test:compliance:entra-roles && npm run test:compliance:entra-oauth && npm run test:compliance:entra-exchange && npm run test:compliance:oauth-transaction && npm run test:compliance:entra-session && npm run test:compliance:entra-readiness && npm run test:compliance:review-queue && npm run test:compliance:remediation && npm run test:compliance:remediation-ledger && npm run test:compliance:remediation-service && npm run test:compliance:remediation-store && npm run test:compliance:dashboard-integration && npm run test:compliance:membership && npm run test:compliance:transaction && npm run test:compliance:sql-scope && npm run test:compliance:scoped-roles && npm run test:compliance:db-security && npm run test:compliance:activation && npm run test:compliance:ai-act-screening && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:compliance": "node --test tests/compliance-versioning.test.mjs",
    "test:compliance:one-time": "node scripts/compliance-one-time-source-monitor.mjs",
    "test:compliance:isolation": "node scripts/compliance-preview-isolation-check.mjs",
    "test:compliance:provisions": "node --experimental-strip-types --test tests/legal-provision-diff.test.mjs",
    "test:compliance:articles": "node --experimental-strip-types --test tests/legal-article-extractor.test.mjs",
    "test:compliance:eurlex": "node --experimental-strip-types --test tests/eurlex-html-extractor.test.mjs",
    "test:compliance:report": "node --experimental-strip-types --test tests/legal-comparison-report.test.mjs",
    "test:compliance:cellar-live": "node scripts/compliance-cellar-live-probe.mjs",
    "test:compliance:versions": "node --experimental-strip-types --test tests/legal-act-version.test.mjs",
    "test:compliance:rodo-import-once": "node --experimental-strip-types scripts/compliance-rodo-import-once.mjs",
    "test:compliance:gdpr-reference": "node --experimental-strip-types --test tests/gdpr-official-references.test.mjs",
    "test:compliance:agent-obligations": "node --experimental-strip-types --test tests/regulatory-obligation-engine.test.mjs",
    "test:compliance:impact": "node --experimental-strip-types --test tests/regulatory-impact-planner.test.mjs",
    "test:compliance:assessment-review": "node --experimental-strip-types --test tests/assessment-review-model.test.mjs",
    "test:compliance:authorization": "node --experimental-strip-types --test tests/assessment-authorization.test.mjs",
    "test:compliance:entra-boundary": "node --experimental-strip-types --test tests/entra-auth-boundary.test.mjs",
    "test:compliance:entra-roles": "node --experimental-strip-types --test tests/entra-role-map.test.mjs",
    "test:compliance:entra-oauth": "node --experimental-strip-types --test tests/entra-oauth-flow.test.mjs",
    "test:compliance:entra-exchange": "node --experimental-strip-types --test tests/entra-code-exchange.test.mjs",
    "test:compliance:oauth-transaction": "node --experimental-strip-types --test tests/entra-oauth-transaction.test.mjs",
    "test:compliance:entra-session": "node --experimental-strip-types --test tests/entra-session.test.mjs",
    "test:compliance:entra-readiness": "node --experimental-strip-types --test tests/entra-setup-readiness.test.mjs",
    "test:compliance:review-queue": "node --experimental-strip-types --test tests/compliance-review-queue.test.mjs",
    "test:compliance:remediation": "node --experimental-strip-types --test tests/remediation-plan.test.mjs",
    "test:compliance:remediation-ledger": "node --experimental-strip-types --test tests/remediation-ledger-integrity.test.mjs",
    "test:compliance:remediation-service": "node --experimental-strip-types --test tests/remediation-application-service.test.mjs",
    "test:compliance:remediation-store": "node --experimental-strip-types --test tests/remediation-scoped-store.test.mjs",
    "test:compliance:dashboard-integration": "node --experimental-strip-types --test tests/compliance-dashboard-integration.test.mjs",
    "test:compliance:membership": "node --experimental-strip-types --test tests/compliance-organization-membership.test.mjs",
    "test:compliance:transaction": "node --experimental-strip-types --test tests/compliance-remediation-transaction.test.mjs",
    "test:compliance:sql-scope": "node --experimental-strip-types --test tests/verified-organization-sql-scope.test.mjs",
    "test:compliance:scoped-roles": "node --experimental-strip-types --test tests/compliance-scoped-organization-principal.test.mjs",
    "test:compliance:db-security": "node --test tests/compliance-db-security-audit.test.mjs",
    "test:compliance:activation": "node --experimental-strip-types --test tests/compliance-runtime-activation.test.mjs",
    "test:compliance:ai-act-screening": "node --experimental-strip-types --test tests/ai-act-risk-screening.test.mjs"
